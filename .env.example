# Local: sslmode=disable is fine. Railway Postgres: use the provided DATABASE_URL (includes sslmode=require).
DATABASE_URL=postgres://user:password@localhost:5432/glassbase?sslmode=disable
# To fill DATABASE_URL (+ PG*) from linked Railway Postgres: make env-railway  (needs jq)
ANTHROPIC_API_KEY=sk-ant-...
APP_ENV=development
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_CONCURRENT=5
# Local dev listen address. On Railway omit this and use PORT only.
HTTP_ADDR=:8080
# Railway sets PORT; do not set HTTP_ADDR unless you need a custom bind.
# PORT=8080
GLASSBASE_RUN_NOW=false
POOL_TUNED=false

# JWT signing secret for admin UI (generate: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated browser origins for CORS (local Vite dev default applied in config if unset there)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
