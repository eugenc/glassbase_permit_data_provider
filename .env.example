# Local: sslmode=disable is fine. Railway Postgres: use the provided DATABASE_URL (includes sslmode=require).
DATABASE_URL=postgres://user:password@localhost:5432/glassbase?sslmode=disable
ANTHROPIC_API_KEY=sk-ant-...
APP_ENV=development
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_CONCURRENT=5
# Local dev listen address. On Railway omit this and use PORT only.
HTTP_ADDR=:8080
# Railway sets PORT; do not set HTTP_ADDR unless you need a custom bind.
# PORT=8080
GLASSBASE_RUN_NOW=false
POOL_TUNED=false
