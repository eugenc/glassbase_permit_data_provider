# Postgres — split URLs for local + cloud (recommended locally)
# If DATABASE_URL is set, it wins for the app and migrate (Railway / CI / docker-compose compatibility).
# Otherwise APP_ENV=production → DATABASE_URL_PROD, else DATABASE_URL_DEV.
DATABASE_URL_DEV=postgres://glassbase:secret@127.0.0.1:5432/glassbase?sslmode=disable
# Railway dev DB (with project linked to env "development"): jq -r '.DATABASE_PUBLIC_URL' <<<"$(railway variables --json -s Postgres)"
DATABASE_URL_PROD=postgresql://postgres:password@your-railway-proxy.example:PORT/railway
# Optional fallback (single URL; overrides split when set):
# DATABASE_URL=
# Optional public proxy duplicate (used if DATABASE_URL unset):
# DATABASE_PUBLIC_URL=

APP_ENV=development
# Migrations: default follows APP_ENV and split vars. Target explicitly:
#   go run ./cmd/migrate -env dev
#   go run ./cmd/migrate -env prod
# Pin one host only:
#   go run ./cmd/migrate -url='postgres://...'

# To mirror Railway Postgres proxy into DATABASE_URL_PROD: ./scripts/sync-env-from-railway.sh
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
MAX_CONCURRENT=5
# Local dev listen address. On Railway omit this and use PORT only.
HTTP_ADDR=:8080
# Railway sets PORT; do not set HTTP_ADDR unless you need a custom bind.
# PORT=8080
GLASSBASE_RUN_NOW=false
POOL_TUNED=false

# Bulk upsert tuning: each DB round-trip inserts min(GLASSBASE_UPSERT_BATCH_MAX_ROWS, floor(GLASSBASE_UPSERT_MAX_BIND_PARAMS / num_columns)) rows.
GLASSBASE_UPSERT_BATCH_MAX_ROWS=2000
GLASSBASE_UPSERT_MAX_BIND_PARAMS=62000

# JWT signing secret for admin UI (generate: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated browser origins for CORS (local Vite dev default applied in config if unset there)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Repair / Claude Code (Railway Dockerfile sets binary CLI mode automatically)
# Install CLI globally: npm install -g @anthropic-ai/claude-code
# GLASSBASE_CLI_WRAPPER=binary
# CLAUDE_BIN=/path/to/claude
# Prefer npx shim when PATH has no global claude but Node/npm is installed:
# CLAUDE_USE_NPX=1
# CLAUDE_WORKDIR=
# If repair hits Anthropic 429 / TPM: DB error_message can be huge — cap prompt + optional compact template + stagger cron:
# GLASSBASE_REPAIR_MAX_LAST_ERROR_RUNES=1200
# GLASSBASE_REPAIR_MAX_RUNS_LOG_RUNES=2400
# GLASSBASE_REPAIR_MAX_RUN_ERR_RUNES=400
# GLASSBASE_REPAIR_COMPACT_PROMPT=true
# GLASSBASE_REPAIR_CRON_STAGGER_SECONDS=75
# Line-buffer repair CLI stderr/stdout when GNU coreutils stdbuf exists (SSE live feed). Alpine: apk add coreutils
# GLASSBASE_REPAIR_STDBUF=0
# Required by cmd/list-broken when querying production from scripts/CI only
# ALLOW_PROD_DB=true
